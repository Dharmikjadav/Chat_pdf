# =============================================================================
# Offline PDF Chatbot — environment configuration
# =============================================================================
# Copy this file to ".env" and adjust as needed:
#     copy .env.example .env        (Windows / cmd)
#     Copy-Item .env.example .env   (PowerShell)
#
# Everything runs locally. Do NOT put any cloud API keys here — none are used.
# =============================================================================

# --- Ollama (local LLM + vision server) --------------------------------------
# Start the server with:  ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# Chat model (used by the chatbot for answering). Read by chatbot + config.
#   pull with:  ollama pull qwen3:8b
OLLAMA_CHAT_MODEL=qwen3:8b

# Vision model (used to interpret charts, scanned pages, complex tables).
#   pull with:  ollama pull qwen2.5vl:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Generation controls
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=8192
OLLAMA_REQUEST_TIMEOUT=600

# GPU: number of model layers to offload to the GPU.
#   999 = put the whole model on the GPU (set 0 to force CPU).
#   Requires NVIDIA GPU + drivers; Ollama auto-detects CUDA.
OLLAMA_NUM_GPU=999

# --- Marker (PDF -> Markdown conversion) -------------------------------------
# Compute device for Marker / PyTorch:  cuda  |  cpu  |  mps
#   cuda = run Marker's OCR/layout/table models on the GPU (needs CUDA PyTorch).
TORCH_DEVICE=cuda
# Force OCR even when the PDF has an embedded text layer (good for scans).
MARKER_FORCE_OCR=false
# Languages passed to the OCR stage (comma-separated ISO codes).
MARKER_LANGS=en
# Max pages to process per document (0 = no limit). Read as MAX_PAGES by config.
MAX_PAGES=0

# Page render resolution (DPI) for the PyMuPDF page images sent to vision.
RENDER_DPI=200

# --- OpenCV region detection (pre-Marker stage) ------------------------------
# Use the GPU for OpenCV ops (needs an OpenCV built WITH CUDA; auto-falls back
# to CPU if cv2.cuda is unavailable). Also enabled implicitly when TORCH_DEVICE=cuda.
OPENCV_USE_GPU=true
# Save annotated bounding-box overlays to <output_dir>/debug/page_NNN_detected.png
OPENCV_DEBUG=false
# A page with at least this many characters is treated as "mostly text" and
# skips OpenCV region detection (Marker handles its text directly).
TEXT_PAGE_CHAR_THRESHOLD=1600

# --- Paths (relative to project root) ----------------------------------------
DATA_DIR=./data
RAW_PDF_DIR=./data/raw_pdfs
PROCESSED_DIR=./data/processed
MARKER_OUTPUT_DIR=./data/marker_output
PAGE_IMAGE_DIR=./data/page_images
IMAGES_DIR=./data/images
PAGEINDEX_DIR=./data/pageindex
MODELS_DIR=./models
LOGS_DIR=./logs
PROMPTS_DIR=./prompts

# --- PageIndex (vector-free, tree-based retrieval) ---------------------------
# Max depth of the document reasoning tree.
PAGEINDEX_MAX_DEPTH=4
# Approx. characters per leaf node before it is split further.
PAGEINDEX_NODE_CHAR_LIMIT=4000
# How many candidate nodes the tree-search keeps at each step.
PAGEINDEX_SEARCH_WIDTH=5

# --- Runtime / logging --------------------------------------------------------
LOG_LEVEL=INFO
# Hard-offline guard: when true, code must never attempt network calls
# except to the local OLLAMA_BASE_URL.
OFFLINE_MODE=true
